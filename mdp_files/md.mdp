integrator  = md
dt          = 0.002
nsteps      = 500000   ; 1 ns

tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 300

pcoupl      = Parrinello-Rahman
pcoupltype  = isotropic
tau_p       = 2.0
ref_p       = 1.0
compressibility = 4.5e-5

constraints = h-bonds

nstxout-compressed = 1000
nstenergy          = 1000
nstlog             = 1000
